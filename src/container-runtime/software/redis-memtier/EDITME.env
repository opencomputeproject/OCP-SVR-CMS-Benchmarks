# Host directory where results will be stored
HOST_RESULTS_DIR=./results

## Build Versions ##
# "latest" resolves to the newest stable x.y.z release tag at build time.
# Rebuild with --no-cache to pick up a newer release.

REDIS_VERSION="latest"			# e.g. "8.2.2"
MEMTIER_VERSION="latest"		# e.g. "2.1.4"

## NUMA / Memory Placement ##
# Mandatory! At least CPU_NUMA_NODE should be configured.

CPU_NUMA_NODE="0"			# CPU NUMA node to bind redis-server to
MEM_NUMA_NODES="0"			# Memory NUMA node(s) to allow for redis-server, comma separated e.g. "0,2"
#NUMA_POLICY="--interleave=0,2"	# numactl memory policy applied to redis-server (replaces --membind)
					# Examples: "--interleave=0,2", "--preferred=2", "--membind=0"
#SERVER_CPU_LIST="2-3"			# Pin redis-server to specific CPUs instead of the whole CPU_NUMA_NODE
#CLIENT_CPU_NUMA_NODE="0"		# CPU NUMA node for memtier (default: CPU_NUMA_NODE)
#CLIENT_CPU_LIST="8-31"			# Pin memtier to specific CPUs instead of a whole node
					# Keep server and client CPUs disjoint so memtier does not steal server cycles

## Redis Server Settings ##

REDIS_MAXMEMORY="2576980377"		# maxmemory in bytes or with unit, e.g. "2576980377", "128gb"
REDIS_MAXMEMORY_POLICY="allkeys-lru"	# Eviction policy
REDIS_APPENDONLY="yes"			# AOF persistence ("yes" | "no"); RDB snapshots are always off
#REDIS_IO_THREADS="4"			# Redis I/O threads (default: redis default)
#REDIS_EXTRA_ARGS=""			# Any additional redis-server arguments, e.g. "--hz 10"

## Memtier Settings ##

MEMTIER_PHASES="fill read mixed"	# Phases to run, in order. Any subset of: fill read mixed
MEMTIER_PERCENTILES="50,90,95,99,99.9"	# Latency percentiles to report
#MEMTIER_EXTRA_ARGS=""			# Additional memtier arguments applied to every phase

# Phase: fill -- write-only, sequential keys, populates the keyspace
FILL_TEST_TIME="240"			# seconds
FILL_CLIENTS="20"			# connections per thread
FILL_THREADS="10"
FILL_PIPELINE="10"
FILL_DATA_SIZE="1024"			# value size in bytes
FILL_RATIO="1:0"			# set:get
FILL_KEY_PATTERN="P:P"			# range split across connections, each walks its slice sequentially
FILL_KEY_MINIMUM="1"
FILL_KEY_MAXIMUM="100000"
#FILL_RATE_LIMIT=""			# ops/sec per connection (default: unlimited)

# Phase: read -- read-only, rate limited, measures latency at a fixed load
READ_TEST_TIME="240"
READ_CLIENTS="10"
READ_THREADS="10"
READ_PIPELINE="1"
READ_DATA_SIZE="1024"
READ_RATIO="0:1"
READ_KEY_PATTERN="P:P"
READ_KEY_MINIMUM="1"
READ_KEY_MAXIMUM="100000"
READ_RATE_LIMIT="500"			# ops/sec per connection: 10 threads x 10 clients x 500 = 50K ops/sec

# Phase: mixed -- 1:10 set:get, unthrottled, measures throughput
MIXED_TEST_TIME="3600"
MIXED_CLIENTS="50"
MIXED_THREADS="4"
MIXED_PIPELINE="1"
MIXED_DATA_SIZE="32"
MIXED_RATIO="1:10"
MIXED_KEY_PATTERN="R:R"			# random keys over the range populated by fill
MIXED_KEY_MINIMUM="1"
MIXED_KEY_MAXIMUM="100000"
#MIXED_RATE_LIMIT=""

## Test Metadata ##

TEST_NOTE="Default Settings"		# Descriptive note appended to the result line
