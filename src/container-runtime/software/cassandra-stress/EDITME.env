# Host directory where results will be stored
HOST_RESULTS_DIR=./results

# Host directory for Cassandra data, commitlog, hints and saved caches (put this on a fast disk)
# WARNING: the data/ commitlog/ hints/ saved_caches/ cdc_raw/ subdirectories are wiped at the start of every run
HOST_DATA_DIR=./data

## Build Version ##
# "x.y" resolves to the newest x.y.z release at build time, "latest" to the newest release overall.
# Rebuild with --no-cache to pick up a newer release.

CASSANDRA_VERSION="5.0"			# e.g. "5.0", "5.0.9", "latest"

## NUMA / Memory Placement ##
# Mandatory! At least CPU_NUMA_NODE should be configured.

CPU_NUMA_NODE="0"			# CPU NUMA node to bind the Cassandra JVM to
MEM_NUMA_NODES="0"			# Memory NUMA node(s) to allow for the Cassandra JVM, comma separated e.g. "0,2"
#NUMA_POLICY="--interleave=0,2"	# numactl memory policy applied to the Cassandra JVM (replaces --membind)
					# Examples: "--interleave=0,2", "--preferred=2", "--membind=0"
#SERVER_CPU_LIST="0-15"			# Pin Cassandra to specific CPUs instead of the whole CPU_NUMA_NODE
#CLIENT_CPU_NUMA_NODE="0"		# CPU NUMA node for cassandra-stress (default: CPU_NUMA_NODE)
#CLIENT_CPU_LIST="16-31"		# Pin cassandra-stress to specific CPUs instead of a whole node
					# Keep server and client CPUs disjoint so the client does not steal server cycles

## Cassandra Server Settings ##

CASSANDRA_HEAP_SIZE="8G"		# JVM heap (MAX_HEAP_SIZE); G1 GC is the 5.0 default
MEMTABLE_ALLOCATION_TYPE="heap_buffers"	# heap_buffers | offheap_buffers | offheap_objects
#CASSANDRA_YAML_OVERRIDES=""		# Extra cassandra.yaml settings, e.g. "concurrent_reads=64,trickle_fsync=false"
#CASSANDRA_JVM_EXTRA_OPTS=""		# Extra JVM options, space separated, e.g. "-XX:+AlwaysPreTouch"

## Stress Settings ##

DOMAIN_POPULATION="10000000"		# Number of blog domains (partitions); populate writes one row to each
					# and phases a/b/c read and write only these domains
STRESS_POP_DIST="gaussian"		# Key access pattern for a/b/c over the domains: gaussian (cassandra-stress
					# default, hot middle) | uniform (every domain equally likely)
STRESS_PHASES="populate a b c"		# Phases to run, in order. Any subset of: populate a b c
STRESS_CL="LOCAL_QUORUM"		# Consistency level (one replica with RF=1)
STRESS_LOG_INTERVAL="60"		# Seconds between progress lines
#STRESS_EXTRA_ARGS=""			# Additional cassandra-stress arguments applied to every phase
COMPACTION_WAIT="1800"			# Max seconds to wait for compactions to settle after populate

# Phase: populate -- one insert per domain, domains visited sequentially
POPULATE_THREADS="64"

# Phase: a -- read heavy
A_OPS="insert=20,singlepost=100"
A_DURATION="120m"
A_THREADS="20"
#A_RATE=""				# fixed ops/sec cap (default: unthrottled)

# Phase: b -- blog mix
B_OPS="insert=2,singlepost=8"
B_DURATION="120m"
B_THREADS="80"
#B_RATE=""

# Phase: c -- write heavy
C_OPS="insert=60,singlepost=40"
C_DURATION="120m"
C_THREADS="20"
#C_RATE=""

## Test Metadata ##

TEST_NOTE="Default Settings"		# Descriptive note appended to the result line
